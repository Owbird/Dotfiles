{
    "layer": "top",
    "position": "top",
    "height": 38,
    "spacing": 8,
    "margin-top": 10,
    "margin-left": 14,
    "margin-right": 14,
    "margin-bottom": 0,
    "modules-left": [
        "custom/start",
        "group/hardware",
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "mpris",
        "bluetooth",
        "group/group-backlight",
        "group/group-volume",
        "network",
        "battery",
        "tray",
        "custom/ctlcenter"
    ],
    "include": [
        "~/.config/waybar/modules.jsonc"
    ]
}
