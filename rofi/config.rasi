configuration {
    modi: "drun,run,window";
    show-icons: true;
    terminal: "alacritty";
    drun-display-format: "{name}";
    display-drun: " Apps";
    display-run: " Run";
    display-window: " Windows";
    font: "IosevkaTerm Nerd Font 12";
    icon-theme: "Papirus-Dark";
    matching: "fuzzy";
    sort: true;
    case-sensitive: false;
    cycle: true;
}

@theme "owbird"
